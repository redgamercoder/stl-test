# Server
PORT=5000
SESSION_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Google OAuth2 (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Anthropic API (used starting in Phase 2 - not required for Phase 1)
ANTHROPIC_API_KEY=
